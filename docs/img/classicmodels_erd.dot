digraph model {
    graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.4,    label="classicmodels (MySQL)", labelloc=t, fontname="Helvetica", fontsize=16];
    node  [shape=plaintext, fontname="Helvetica", fontsize=10];
    edge  [color="#5d6b7d", arrowsize=0.7];
    customers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>customers</B></TD></TR><TR><TD ALIGN="LEFT"><B>customerNumber</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">customerName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">contactLastName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">contactFirstName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">addressLine1</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">addressLine2</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">postalCode</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">salesRepEmployeeNumber</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">creditLimit</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DECIMAL</FONT></TD></TR></TABLE>>];
    employees [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT"><B>employeeNumber</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">lastName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">firstName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">extension</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">officeCode</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">reportsTo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">jobTitle</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR></TABLE>>];
    offices [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>offices</B></TD></TR><TR><TD ALIGN="LEFT"><B>officeCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">addressLine1</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">addressLine2</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">country</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">postalCode</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">territory</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR></TABLE>>];
    orderdetails [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>orderdetails</B></TD></TR><TR><TD ALIGN="LEFT"><B>orderNumber</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>productCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">quantityOrdered</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">priceEach</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DECIMAL</FONT></TD></TR><TR><TD ALIGN="LEFT">orderLineNumber</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR></TABLE>>];
    orders [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>orders</B></TD></TR><TR><TD ALIGN="LEFT"><B>orderNumber</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">orderDate</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT">requiredDate</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT">shippedDate</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">comments</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">customerNumber</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR></TABLE>>];
    payments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>payments</B></TD></TR><TR><TD ALIGN="LEFT"><B>customerNumber</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>checkNumber</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">paymentDate</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT">amount</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DECIMAL</FONT></TD></TR></TABLE>>];
    productlines [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>productlines</B></TD></TR><TR><TD ALIGN="LEFT"><B>productLine</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">textDescription</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">htmlDescription</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">MEDIUMTEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">image</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">MEDIUMBLOB</FONT></TD></TR></TABLE>>];
    products [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>products</B></TD></TR><TR><TD ALIGN="LEFT"><B>productCode</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">productName</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">productLine</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">productScale</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">productVendor</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">productDescription</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">quantityInStock</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT">buyPrice</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DECIMAL</FONT></TD></TR><TR><TD ALIGN="LEFT">MSRP</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DECIMAL</FONT></TD></TR></TABLE>>];
    employees -> customers;
    employees -> employees;
    offices -> employees;
    orders -> orderdetails;
    products -> orderdetails;
    customers -> orders;
    customers -> payments;
    productlines -> products;
}