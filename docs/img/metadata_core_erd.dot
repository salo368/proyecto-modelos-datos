digraph model {
    graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.4,    label="Repositorio de metadatos - nucleo (fuentes, negocio y linaje)", labelloc=t, fontname="Helvetica", fontsize=16];
    node  [shape=plaintext, fontname="Helvetica", fontsize=10];
    edge  [color="#5d6b7d", arrowsize=0.7];
    business_attribute [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>business_attribute</B></TD></TR><TR><TD ALIGN="LEFT"><B>attribute_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">attribute_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">attribute_definition</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    business_entity [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>business_entity</B></TD></TR><TR><TD ALIGN="LEFT"><B>entity_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">data_domain</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR></TABLE>>];
    column_business_mapping [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>column_business_mapping</B></TD></TR><TR><TD ALIGN="LEFT"><B>mapping_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">column_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">attribute_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR></TABLE>>];
    data_source [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>data_source</B></TD></TR><TR><TD ALIGN="LEFT"><B>source_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">source_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">db_engine</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    db_column [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>db_column</B></TD></TR><TR><TD ALIGN="LEFT"><B>column_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">table_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">column_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">ordinal_position</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">data_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">native_data_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">is_nullable</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">is_primary_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">is_foreign_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">fk_ref_column_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">loaded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>];
    db_table [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>db_table</B></TD></TR><TR><TD ALIGN="LEFT"><B>table_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">source_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">schema_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">table_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">table_description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">row_count_approx</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">loaded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>];
    business_entity -> business_attribute;
    business_attribute -> column_business_mapping;
    db_column -> column_business_mapping;
    db_column -> db_column;
    db_table -> db_column;
    data_source -> db_table;
}