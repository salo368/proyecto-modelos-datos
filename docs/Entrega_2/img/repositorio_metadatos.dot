digraph modelo {
    graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.4,    label="Repositorio de Metadatos - Entregas 1 y 2", labelloc=t, fontname="Helvetica", fontsize=16];
    node  [shape=plaintext, fontname="Helvetica", fontsize=10];
    edge  [color="#5d6b7d", arrowsize=0.7];
    business_attribute [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>business_attribute</B></TD></TR><TR><TD ALIGN="LEFT"><B>attribute_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">attribute_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">attribute_definition</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    business_entity [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>business_entity</B></TD></TR><TR><TD ALIGN="LEFT"><B>entity_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">entity_description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">data_domain</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR></TABLE>>];
    column_business_mapping [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>column_business_mapping</B></TD></TR><TR><TD ALIGN="LEFT"><B>mapping_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">column_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">attribute_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR></TABLE>>];
    data_source [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>data_source</B></TD></TR><TR><TD ALIGN="LEFT"><B>source_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">source_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">db_engine</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    db_column [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>db_column</B></TD></TR><TR><TD ALIGN="LEFT"><B>column_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">table_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">column_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">ordinal_position</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">data_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">native_data_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">is_nullable</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">is_primary_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">is_foreign_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">fk_ref_column_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">loaded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>];
    db_table [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>db_table</B></TD></TR><TR><TD ALIGN="LEFT"><B>table_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">source_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">schema_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">table_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">table_description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">row_count_approx</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">loaded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>];
    dq_result [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dq_result</B></TD></TR><TR><TD ALIGN="LEFT"><B>dq_result_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">dq_rule_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">etl_execution_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">evaluated_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT">rows_evaluated</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">rows_failed</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">passed</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR></TABLE>>];
    dq_rule [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dq_rule</B></TD></TR><TR><TD ALIGN="LEFT"><B>dq_rule_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">rule_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">rule_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">criterio_dama</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">clase_dq</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">capa</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">source_column_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">expression</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">severity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">resolution</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    dw_attribute [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dw_attribute</B></TD></TR><TR><TD ALIGN="LEFT"><B>dw_attribute_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">dw_object_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">attribute_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">data_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">attribute_role</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    dw_lineage [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dw_lineage</B></TD></TR><TR><TD ALIGN="LEFT"><B>dw_lineage_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">source_column_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">target_measure_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">target_attribute_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">transformation_rule</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    dw_measure [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dw_measure</B></TD></TR><TR><TD ALIGN="LEFT"><B>dw_measure_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">dw_object_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">measure_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">data_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">additivity</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">formula</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    dw_object [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dw_object</B></TD></TR><TR><TD ALIGN="LEFT"><B>dw_object_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">object_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">object_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">grain</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">is_conformed</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">scd_type</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">scd_justificacion</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">row_count</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">loaded_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR></TABLE>>];
    etl_execution [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>etl_execution</B></TD></TR><TR><TD ALIGN="LEFT"><B>etl_execution_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">etl_process_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">run_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT">finished_at</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">rows_read</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">rows_written</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">rows_rejected</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    etl_process [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>etl_process</B></TD></TR><TR><TD ALIGN="LEFT"><B>etl_process_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">process_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">tool</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">source_systems</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">target_system</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR></TABLE>>];
    usage_acceso_objeto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>usage_acceso_objeto</B></TD></TR><TR><TD ALIGN="LEFT"><B>usage_acceso_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">dw_object_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">medido_en</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT">lecturas_secuenciales</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT">filas_leidas_secuencial</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT">lecturas_por_indice</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT">filas_insertadas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT">filas_actualizadas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT">filas_borradas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR></TABLE>>];
    usage_consulta [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>usage_consulta</B></TD></TR><TR><TD ALIGN="LEFT"><B>usage_consulta_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">usage_herramienta_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">proposito</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">frecuencia</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">nro_joins</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR></TABLE>>];
    usage_consulta_objeto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>usage_consulta_objeto</B></TD></TR><TR><TD ALIGN="LEFT"><B>usage_consulta_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>dw_object_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR></TABLE>>];
    usage_herramienta [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>usage_herramienta</B></TD></TR><TR><TD ALIGN="LEFT"><B>usage_herramienta_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">proposito</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">acceso</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR></TABLE>>];
    business_entity -> business_attribute;
    business_attribute -> column_business_mapping;
    db_column -> column_business_mapping;
    db_column -> db_column;
    db_table -> db_column;
    data_source -> db_table;
    dq_rule -> dq_result;
    etl_execution -> dq_result;
    db_column -> dq_rule;
    dw_object -> dw_attribute;
    db_column -> dw_lineage;
    dw_attribute -> dw_lineage;
    dw_measure -> dw_lineage;
    dw_object -> dw_measure;
    etl_process -> etl_execution;
    dw_object -> usage_acceso_objeto;
    usage_herramienta -> usage_consulta;
    dw_object -> usage_consulta_objeto;
    usage_consulta -> usage_consulta_objeto;
}