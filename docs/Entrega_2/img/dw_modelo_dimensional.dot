digraph modelo {
    graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.4,    label="Almacen de Datos - Modelo Dimensional (Entrega 2)", labelloc=t, fontname="Helvetica", fontsize=16];
    node  [shape=plaintext, fontname="Helvetica", fontsize=10];
    edge  [color="#5d6b7d", arrowsize=0.7];
    dim_cliente [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#e9f2f0"><B>dim_cliente</B></TD></TR><TR><TD ALIGN="LEFT"><B>cliente_key</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">numero_cliente</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre_cliente</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">contacto_nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">contacto_apellido</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">telefono</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">direccion_completa</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">ciudad</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">estado_region</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">codigo_postal</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">pais</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">limite_credito</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC</FONT></TD></TR><TR><TD ALIGN="LEFT">presente_en_ventas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">presente_en_servicio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR></TABLE>>];
    dim_empleado [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dim_empleado</B></TD></TR><TR><TD ALIGN="LEFT"><B>empleado_key</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">numero_empleado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">sistema_origen</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">apellido</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">cargo</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">numero_oficina</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR></TABLE>>];
    dim_estado_orden [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dim_estado_orden</B></TD></TR><TR><TD ALIGN="LEFT"><B>estado_key</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">es_efectiva</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR></TABLE>>];
    dim_oficina [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#eef1f5"><B>dim_oficina</B></TD></TR><TR><TD ALIGN="LEFT"><B>oficina_key</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">codigo_oficina</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">ciudad</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">pais</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">region</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">territorio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR></TABLE>>];
    dim_producto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#e9f2f0"><B>dim_producto</B></TD></TR><TR><TD ALIGN="LEFT"><B>producto_key</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">codigo_producto</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre_producto</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">linea_producto</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">descripcion_linea</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">escala</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">proveedor</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">precio_compra</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC</FONT></TD></TR><TR><TD ALIGN="LEFT">precio_msrp</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC</FONT></TD></TR><TR><TD ALIGN="LEFT">presente_en_ventas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">presente_en_servicio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR></TABLE>>];
    dim_tiempo [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#e9f2f0"><B>dim_tiempo</B></TD></TR><TR><TD ALIGN="LEFT"><B>tiempo_key</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT">anio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT">trimestre</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT">mes</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre_mes</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">dia</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT">dia_semana</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT">nombre_dia</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT">es_fin_semana</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT">anio_mes</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">CHAR</FONT></TD></TR></TABLE>>];
    fact_llamadas_servicio [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f7ecf1"><B>fact_llamadas_servicio</B></TD></TR><TR><TD ALIGN="LEFT"><B>llamada_key</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT">tiempo_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">cliente_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">producto_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">empleado_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">texto_llamada</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT">cantidad_llamadas</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT">longitud_texto</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR></TABLE>>];
    fact_ventas [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD COLSPAN="2" BGCOLOR="#f7ecf1"><B>fact_ventas</B></TD></TR><TR><TD ALIGN="LEFT"><B>venta_key</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT">tiempo_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">cliente_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">producto_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">empleado_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">oficina_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">estado_key</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">numero_orden</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">numero_linea</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR><TR><TD ALIGN="LEFT">cantidad_ordenada</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT">precio_unitario</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC</FONT></TD></TR><TR><TD ALIGN="LEFT">monto_linea</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC</FONT></TD></TR><TR><TD ALIGN="LEFT">costo_linea</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC</FONT></TD></TR><TR><TD ALIGN="LEFT">margen_linea</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC</FONT></TD></TR><TR><TD ALIGN="LEFT">precio_msrp</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">NUMERIC</FONT></TD></TR><TR><TD ALIGN="LEFT">dias_hasta_envio</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">SMALLINT</FONT></TD></TR></TABLE>>];
    dim_cliente -> fact_llamadas_servicio;
    dim_empleado -> fact_llamadas_servicio;
    dim_producto -> fact_llamadas_servicio;
    dim_tiempo -> fact_llamadas_servicio;
    dim_cliente -> fact_ventas;
    dim_empleado -> fact_ventas;
    dim_estado_orden -> fact_ventas;
    dim_oficina -> fact_ventas;
    dim_producto -> fact_ventas;
    dim_tiempo -> fact_ventas;
}