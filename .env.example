# ============================================================
# Connection strings for the local docker-compose stack.
#
# These values work as-is with `docker compose up`. run_all.py
# copies this file to .env the first time it runs; .env itself
# is git-ignored.
# ============================================================

# Source 1 - classicmodels (MySQL)
CLASSICMODELS_URL=mysql+pymysql://root:javeriana@localhost:3307/classicmodels

# Source 2 - customerservice (PostgreSQL)
CUSTOMERSERVICE_URL=postgresql+psycopg2://postgres:javeriana@localhost:5433/customerservice

# Metadata repository (PostgreSQL)
METADATA_URL=postgresql+psycopg2://postgres:javeriana@localhost:5434/metadata

# Pipeline staging area (PostgreSQL, same instance; not part of the warehouse)
STAGING_URL=postgresql+psycopg2://postgres:javeriana@localhost:5434/staging

# Data warehouse (PostgreSQL, same instance as the metadata repository)
DW_URL=postgresql+psycopg2://postgres:javeriana@localhost:5434/dw

# Metabase
METABASE_URL=http://localhost:3000
