# ============================================================
# Cadenas de conexion del proyecto.
#
# Estos son los valores del stack LOCAL de docker-compose y
# funcionan tal cual: no hay que cambiar nada para correr el
# proyecto en tu maquina.
#
# run_all.py copia este archivo a .env la primera vez.
# El .env real esta en .gitignore y nunca se sube al repositorio.
# ============================================================

# Fuente 1 - classicmodels (MySQL)
URL_MYSQLDATABASE=mysql+pymysql://root:javeriana@localhost:3307/classicmodels

# Fuente 2 - customerservice (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:javeriana@localhost:5433/customerservice

# Repositorio de metadatos (PostgreSQL)
METADATA_REPO_URL=postgresql+psycopg2://postgres:javeriana@localhost:5434/metadata

# Almacen de datos (PostgreSQL, misma instancia que el repositorio)
DW_URL=postgresql+psycopg2://postgres:javeriana@localhost:5434/dw

# Metabase
METABASE_URL=http://localhost:3000
